# ==============================================================================
# Autonomous SRE Agent — Environment Configuration Template
# Copy this file to `.env` and fill in your keys:
#     cp .env.example .env
# ==============================================================================

# --- 1. LLM Providers (Free Tiers Supported — Multi-Provider Auto-Failover) ---
GEMINI_API_KEY=your_google_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# --- 2. Live Cloud Adapters (Optional — leave blank for Sandbox Mode) ---
VERCEL_TOKEN=
SUPABASE_DB_URL=
GITHUB_TOKEN=

# --- 3. Target Application Topology (Used by HippoRAG Graph & Dashboard) ---
TARGET_APP_NAME=my-web-app
TARGET_APP_URL=https://my-web-app.vercel.app
TARGET_GITHUB_REPO=your-username/your-repo
TARGET_DB_TABLES=users,orders,payments,sessions

# --- 4. Optional Neo4j Live Sync ---
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
